{
  "$id": "https://example.invalid/splay-am-decide-v0.4/schemas/locality_witness.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Locality refutation/support witness (open payload).",
  "properties": {
    "independent_checker_result": {
      "enum": [
        "AGREE",
        "DISAGREE"
      ],
      "type": "string"
    },
    "node": {
      "const": "MST0-08U"
    },
    "replay_certificate": {
      "additionalProperties": false,
      "properties": {
        "checker_id": {
          "minLength": 1,
          "type": "string"
        },
        "replay_input_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "result": {
          "const": "REPRODUCED"
        }
      },
      "required": [
        "replay_input_hash",
        "checker_id",
        "result"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "1.0"
    },
    "witness_payload": {
      "description": "Open-world witness payload.",
      "type": [
        "object",
        "array"
      ]
    }
  },
  "required": [
    "schema_version",
    "node",
    "witness_payload",
    "replay_certificate",
    "independent_checker_result"
  ],
  "title": "locality_witness",
  "type": "object"
}
