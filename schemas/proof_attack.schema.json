{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "best_obstruction_metrics": {
      "description": "Best finite obstruction metrics observed (never a theorem premise).",
      "type": "object"
    },
    "exact_witness": {
      "description": "Exact legal witness, if found. Null when the attack survived. For REFUTE(MST0-17) this MUST carry the full endpoint-aware payload defined below; this object is intentionally open-world (no additionalProperties:false) per v0.4.2 B2.",
      "properties": {
        "A_n": {
          "description": "Additive term A(n), exact.",
          "$ref": "#/$defs/rational"
        },
        "E_0": {
          "description": "Initial energy/flow term, exact.",
          "$ref": "#/$defs/rational"
        },
        "E_m": {
          "description": "Terminal energy/flow term, exact.",
          "$ref": "#/$defs/rational"
        },
        "L_0": {
          "description": "Initial ledger identity and trace anchor.",
          "$ref": "#/$defs/ledger_ref"
        },
        "L_m": {
          "description": "Terminal ledger identity and trace anchor.",
          "$ref": "#/$defs/ledger_ref"
        },
        "T": {
          "description": "Initial BST.",
          "$ref": "#/$defs/tree"
        },
        "X": {
          "description": "Full access sequence.",
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "Y": {
          "description": "Subsequence of X under test.",
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "block_decomposition": {
          "description": "Canonical/frozen block decomposition used by the evaluation.",
          "$ref": "#/$defs/block_decomposition"
        },
        "lhs": {
          "description": "Exact left-hand side of the attacked inequality (for MST0-17: Splay(Y,T)+E_m-E_0).",
          "$ref": "#/$defs/rational"
        },
        "n": {
          "description": "Key-set size.",
          "type": "integer"
        },
        "paired_execution": {
          "description": "Full paired-execution trace reference.",
          "$ref": "#/$defs/execution_ref"
        },
        "residual": {
          "description": "Exact strict residual lhs-rhs. Positive iff the witness refutes.",
          "$ref": "#/$defs/rational"
        },
        "rhs": {
          "description": "Exact right-hand side of the attacked inequality (for MST0-17: 2*Splay(X,T)+A(n)).",
          "$ref": "#/$defs/rational"
        },
        "splay_X": {
          "description": "Exact Splay(X,T) cost.",
          "$ref": "#/$defs/rational"
        },
        "splay_Y": {
          "description": "Exact Splay(Y,T) cost.",
          "$ref": "#/$defs/rational"
        },
        "subsequence_certificate": {
          "description": "Machine-checkable certificate that Y << X.",
          "$ref": "#/$defs/subsequence_certificate"
        }
      },
      "type": [
        "object",
        "null"
      ]
    },
    "generator_version": {
      "type": "string"
    },
    "independent_checker_result": {
      "type": "object"
    },
    "input_hash": {
      "type": "string"
    },
    "negation_sha256": {
      "type": "string"
    },
    "objective_vector": {
      "type": "object"
    },
    "replay_certificate": {
      "type": "object"
    },
    "schema_version": {
      "const": "DECIDE-PROOF-ATTACK-v0.4"
    },
    "scientific_interpretation": {
      "type": "string"
    },
    "seed_or_symbolic_family": {
      "type": "string"
    },
    "theorem_id": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "theorem_id",
    "negation_sha256",
    "generator_version",
    "seed_or_symbolic_family",
    "input_hash",
    "exact_witness",
    "objective_vector",
    "best_obstruction_metrics",
    "replay_certificate",
    "independent_checker_result",
    "scientific_interpretation"
  ],
  "title": "proof_attack",
  "$defs": {
    "block_decomposition": {
      "additionalProperties": false,
      "properties": {
        "block_hashes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "canonical": {
          "type": "boolean"
        }
      },
      "required": [
        "canonical",
        "block_hashes"
      ],
      "type": "object"
    },
    "execution_ref": {
      "additionalProperties": false,
      "properties": {
        "event_count": {
          "type": "integer"
        },
        "trace_hash": {
          "type": "string"
        }
      },
      "required": [
        "trace_hash",
        "event_count"
      ],
      "type": "object"
    },
    "ledger_ref": {
      "additionalProperties": false,
      "properties": {
        "energy": {
          "$ref": "#/$defs/rational"
        },
        "ledger_hash": {
          "type": "string"
        }
      },
      "required": [
        "ledger_hash",
        "energy"
      ],
      "type": "object"
    },
    "rational": {
      "additionalProperties": false,
      "properties": {
        "den": {
          "type": [
            "integer",
            "string"
          ]
        },
        "num": {
          "type": [
            "integer",
            "string"
          ]
        }
      },
      "required": [
        "num",
        "den"
      ],
      "type": "object"
    },
    "subsequence_certificate": {
      "additionalProperties": false,
      "properties": {
        "indices": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "valid": {
          "const": true
        }
      },
      "required": [
        "indices",
        "valid"
      ],
      "type": "object"
    },
    "tree": {
      "additionalProperties": false,
      "properties": {
        "keys": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "structure_hash": {
          "type": "string"
        }
      },
      "required": [
        "keys",
        "structure_hash"
      ],
      "type": "object"
    }
  },
  "type": "object"
}
