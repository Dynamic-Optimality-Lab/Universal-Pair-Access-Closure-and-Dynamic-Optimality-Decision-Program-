{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "A_n": {
      "$ref": "#/$defs/rational"
    },
    "E_0": {
      "$ref": "#/$defs/rational"
    },
    "E_m": {
      "$ref": "#/$defs/rational"
    },
    "L_0_hash": {
      "type": "string"
    },
    "L_m_hash": {
      "type": "string"
    },
    "block_decomposition_hash": {
      "type": "string"
    },
    "certificate_id": {
      "type": "string"
    },
    "checker_result": {
      "type": "object"
    },
    "lhs": {
      "$ref": "#/$defs/rational"
    },
    "n": {
      "type": "integer"
    },
    "replay_result": {
      "type": "object"
    },
    "residual": {
      "$ref": "#/$defs/rational"
    },
    "rhs": {
      "$ref": "#/$defs/rational"
    },
    "schema_version": {
      "const": "DECIDE-PAIR-ACCESS-CERT-v0.4"
    },
    "splay_X": {
      "$ref": "#/$defs/rational"
    },
    "splay_Y": {
      "$ref": "#/$defs/rational"
    },
    "statement_sha256": {
      "type": "string"
    },
    "strict_positive_residual": {
      "type": "boolean"
    },
    "subsequence_certificate": {
      "$ref": "#/$defs/subsequence_certificate"
    },
    "theorem_id": {
      "const": "MST0-17"
    },
    "witness_ref": {
      "description": "Input hash of the evaluated witness (binds to the proof_attack record).",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "certificate_id",
    "theorem_id",
    "statement_sha256",
    "witness_ref",
    "n",
    "L_0_hash",
    "L_m_hash",
    "E_0",
    "E_m",
    "splay_X",
    "splay_Y",
    "A_n",
    "lhs",
    "rhs",
    "residual",
    "strict_positive_residual",
    "subsequence_certificate",
    "block_decomposition_hash",
    "replay_result",
    "checker_result"
  ],
  "title": "pair_access_certificate",
  "$defs": {
    "rational": {
      "additionalProperties": false,
      "properties": {
        "den": {
          "type": [
            "integer",
            "string"
          ]
        },
        "num": {
          "type": [
            "integer",
            "string"
          ]
        }
      },
      "required": [
        "num",
        "den"
      ],
      "type": "object"
    },
    "subsequence_certificate": {
      "additionalProperties": false,
      "properties": {
        "indices": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "valid": {
          "const": true
        }
      },
      "required": [
        "indices",
        "valid"
      ],
      "type": "object"
    }
  },
  "type": "object"
}
